PORT=3500

# URL of the database to connect to. example if using docker compose:
DATABASE_URL=postgresql://workscale:workscale_dev_password@host.docker.internal:5432/workscale

# Used only for development and testing purposes
TENANT_MIGRATION_SCHEMA=tenant_dev

# Enable or disable the trust proxy setting for the application. Set to true if the application is behind a reverse proxy (e.g., Nginx, Heroku, etc.) and you want to trust the X-Forwarded-* headers.
TRUST_PROXY=false
